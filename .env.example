# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Bazos
# By default the bot uses the curated feed list in data/bazos_search_urls.json.
# Set one of these to override it entirely:
# Single URL: BAZOS_SEARCH_URL
# Or multiple comma-separated URLs: BAZOS_SEARCH_URLS=https://...rss.php?... , https://...rss.php?...
# Examples:
# - General 'mobile' category (all brands, incl. irrelevant ones like Apple/Realme): https://www.bazos.sk/rss.php?rub=mo
# - Xiaomi category on bazos.sk (cat=451): https://www.bazos.sk/rss.php?rub=mo&cat=451
# - Xiaomi category on bazos.cz (cat=455): https://www.bazos.cz/rss.php?rub=mo&cat=455
# BAZOS_SEARCH_URL=
# BAZOS_SEARCH_URLS=
# Poll interval in seconds
CHECK_INTERVAL=
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# PostmarketOS models file
POSTMARKETOS_MODELS_FILE=data/postmarketos_models.json
# Minimum listing price in EUR
MIN_PRICE_EUR=10
# Maximum listing price in EUR
MAX_PRICE_EUR=51
# Minimum curated device score (1-5, see data/postmarketos_models.json) required to notify.
# Matches for a device with no score on record are never filtered. Set to 0 to disable this filter.
MIN_K3S_SCORE=2